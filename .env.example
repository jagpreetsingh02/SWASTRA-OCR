# Copy to .env and fill in locally. .env is git-ignored; never commit a real token.
#
# Only needed for gated or private Hugging Face repositories. The models this engine uses
# (Qwen/Qwen3-VL-2B-Instruct and Ihor/gliner-biomed-large-v1.0) are public, so this can stay
# empty for normal local use.
HF_TOKEN=

# Optional: where Hugging Face keeps downloaded weights (defaults to ~/.cache/huggingface)
# HF_HOME=

# Optional server settings
# MEDIKIOSK_OCR_PRELOAD=1          # 0 = do not load models at start-up (they load on first request)
# MEDIKIOSK_OCR_MAX_CONCURRENT=1   # documents processed at once
