.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# local secrets and settings: never commit a real token
.env
.env.*
!.env.example

# model weights and Hugging Face caches (gigabytes; fetched on demand)
hf_cache/
huggingface/
models/
*.safetensors
*.gguf
*.pt
*.bin

# uploaded or temporary documents (may contain patient data)
uploads/
tmp/

# real-world validation documents: real (CC BY 4.0) de-identified medical images.
# Kept local by default -- manifest.json, hashes, truth files and docs are committed instead.
eval/real_world/rw_*.jpeg
eval/real_world/rw_*.jpg
eval/real_world/rw_*.png

# OCR model-selection runs over those pages: the per-engine files embed each model's
# verbatim transcription of a real prescription, which can carry patient identifiers
# (rw_013 does). Only the aggregate scores, which contain no free text, are committed.
eval/reports/model_selection_real_world/*.json
!eval/reports/model_selection_real_world/summary.json
!eval/reports/model_selection_real_world/dangerous_errors.json
!eval/reports/model_selection_real_world/paddleocr-vl.INCOMPLETE.json
