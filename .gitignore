.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Environment and credentials remain local.
.env
.env.*
!.env.example

# Model weights, caches and archives are never repository artifacts.
hf_cache/
huggingface/
.cache/
models/
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.bin
*.zip
*.tar
*.gz
*.7z
*.bundle

# Private documents, external datasets and recovery copies.
/prescription-data/
/external-data/
/datasets/
uploads/
tmp/
privacy-recovery/

# Every real-world source, transcription and annotation stays local, regardless of filename.
/eval/real_world*/**
!/eval/real_world*/README.md
!/eval/real_world*/DATASET.md
!/eval/real_world*/manifest.json
!/eval/real_world*/truth_template.json

# Generated reports may embed identifiers, even when a run is incomplete.
/eval/reports/real_world*
/eval/reports/SUMMARY.md
/eval/reports/model_selection_real_world/**
!/eval/reports/model_selection_real_world/summary.json
# The exception is numeric aggregates only, checked by tools/check_privacy.py.
